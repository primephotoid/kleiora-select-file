# Backend (run from backend/)
PORT=4000
APP_ENV=development
# Format: user:password@tcp(host:port)/database?charset=utf8mb4&parseTime=True&loc=Asia%2FMakassar
DATABASE_URL=root:@tcp(127.0.0.1:3306)/kleiora?charset=utf8mb4&parseTime=True&loc=Asia%2FMakassar
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_DRIVE_API_KEY=
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=uploads

# Seeder admin: go run ./cmd/seed-admin
ADMIN_EMAIL=admin@kleiora.local
ADMIN_PASSWORD=ganti-dengan-password-kuat
ADMIN_FULL_NAME=Administrator Kleiora
ADMIN_STUDIO_NAME=Kleiora Grads
